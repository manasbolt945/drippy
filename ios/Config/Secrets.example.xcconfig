// Copy to Secrets.xcconfig (git-ignored) and fill in.
// xcconfig treats "//" as a comment, so URLs are written with "/$()/".

// Local `supabase start`: http:/$()/127.0.0.1:54321 (Simulator only)
SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-KEY

// Meta app id, required by Instagram Stories sharing
FACEBOOK_APP_ID = YOUR-FACEBOOK-APP-ID

DEVELOPMENT_TEAM =
