# Copy to .env.local. Leave both empty to run in demo mode (sample results, no backend).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Product analytics (PostHog). Leave empty to send nothing. The project key starts with phc_ and is safe to be public.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
